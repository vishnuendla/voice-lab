# Browser voice lab — uv run python -m voice_assistant.web
# Open http://127.0.0.1:7860

# --- LLM -------------------------------------------------------------------
# Groq answers; if it errors mid-session the pipeline fails over to the backup
# for the following turns. A provider with no key is skipped, so Groq alone or
# OpenRouter alone both work.
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
LLM_MODEL=openai/gpt-oss-120b

LLM_FALLBACK_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_FALLBACK_MODEL=minimax/minimax-m3:free

# LLM_MAX_TOKENS=180
# LLM_TIMEOUT_SECONDS=30

# --- Speech ----------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_key_here

# Defaults: Sarvam STT + TTS. Whisper/Piper run locally if Sarvam has no credits.
# STT_PROVIDER=sarvam        # sarvam | whisper
# TTS_PROVIDER=sarvam        # sarvam | piper
# SARVAM_LANGUAGE=en-IN
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# LANGUAGE=en
# PIPER_VOICE=en_US-ryan-high

# --- Web lab ---------------------------------------------------------------
# WEB_LAB_HOST=127.0.0.1
# WEB_LAB_PORT=7860
# By default, the browser WebSocket accepts only loopback page origins.
# Set a comma-separated exact origin allowlist when using a trusted reverse proxy.
# WEB_LAB_ALLOWED_ORIGINS=https://voice.example.com

# --- Persistence -----------------------------------------------------------
# Unset = in-memory only. With it, conversations resume, sessions are
# summarized when they end, and long-term memories carry across sessions.
# Create the database once: createdb voice_lab
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/voice_lab
# MAX_MESSAGES=20
# MEMORY_EXTRACTION=1        # 0 disables the end-of-session summary

# --- Telephony (uv sync --group telephony) ---------------------------------
# VOBIZ_AUTH_ID=your_vobiz_auth_id
# VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
# VOBIZ_FROM_NUMBER=auto
# PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# TELEPHONY_HOST=0.0.0.0
# TELEPHONY_PORT=5000
# TELEPHONY_SPEAK_ONLY=false

# --- Legacy desktop CLI (uv sync --group desktop) --------------------------
# SEARCH_ENABLED=false
# TAVILY_API_KEY=your_tavily_key_here
# LOG_LEVEL=INFO
# LOG_TRANSCRIPTS=false
